# Copia este archivo a .env (nunca subas .env al repositorio)

# Genera una clave: python -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=change-me
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL es obligatorio (también en desarrollo): docker compose up -d db
DATABASE_URL=postgres://gestorpro:gestorpro@localhost:5432/gestorpro

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# URL del frontend (enlaces de invitación). En producción, el dominio público.
FRONTEND_URL=http://localhost:5173

# Plan con el que arrancan (en prueba) las empresas nuevas: starter | business | pro
DEFAULT_PLAN_CODE=starter

# Límite de intentos de login/registro por IP
THROTTLE_AUTH=10/min

# Solo para seed_demo en desarrollo (si se omite, se genera una aleatoria)
DEMO_PASSWORD=

# IA — Groq (opcional)
GROQ_API_KEY=
